<persistence xmlns="http://java.sun.com/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
    version="2.0">
    <persistence-unit name="twitter-clone-persistence-unit">
        <description>Persistence unit for Twitter Clone</description>

        <!-- Add Entity classes -->
        <class>core.User</class>
        <class>core.Post</class>

        <properties>
            <!-- Database connection settings -->
            <property name="hibernate.dialect"
                value="org.hibernate.community.dialect.SQLiteDialect" />
            <property
                name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC" />
            <property
                name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:../twitter-clone.db" />
            <property
                name="jakarta.persistence.jdbc.user" value="" />
            <property
                name="jakarta.persistence.jdbc.password" value="" />

            <!-- Automatically export the schema
            Use "create" if you'd like a clean database at each start.
            For more details, see:
            https://jakarta.ee/specifications/persistence/3.2/jakarta-persistence-spec-3.2#a12384 -->
            <property
                name="jakarta.persistence.schema-generation.database.action" value="update" />

            <!-- Echo all executed SQL to console -->
            <property
                name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql"
                value="true" />
            <property name="hibernate.highlight_sql" value="true" />
        </properties>
    </persistence-unit>
</persistence>
