      <Button fx:id="backBtn" layoutX="30.0" layoutY="25.0" mnemonicParsing="false" text="Back" onAction="#switchToFeed">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <VBox alignment="CENTER" layoutX="415.0" layoutY="135.0" prefHeight="450.0" prefWidth="450.0" style="-fx-background-color: #fafafa; -fx-background-radius: 15; -fx-border-width: 3; -fx-border-color: #123456; -fx-border-radius: 8;">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Create a new post">
               <font>
                  <Font name="System Bold" size="26.0" />
