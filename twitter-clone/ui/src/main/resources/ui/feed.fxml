<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.FeedController">
   <top>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" style="-fx-border-width: 0 0 4 0; -fx-border-color: #123456;" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="newPostBtn" mnemonicParsing="false" onAction="#switchToMakeNewPost" prefHeight="40.0" prefWidth="90.0" text="New Post">
               <HBox.margin>
                  <Insets left="50.0" />
               </HBox.margin>
            </Button>
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Label text="MY TWITTER FEED">
               <font>
                  <Font size="23.0" />
               </font>
            </Label>
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="profileBtn" mnemonicParsing="false" onAction="#switchToProfile" styleClass="profile-button" BorderPane.alignment="CENTER_RIGHT">
               <HBox.margin>
                  <Insets right="50.0" />
               </HBox.margin>
               <graphic>
                  <VBox>
                     <children>
                        <Label fx:id="displayNameLabel" text="Display Name">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                        <Label fx:id="usernameLabel" text="\@username" textFill="#0000007f">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </graphic>
            </Button>
         </children>
      </HBox>
   </top>
   <center>
      <ListView fx:id="feedList" focusTraversable="false" prefHeight="200.0" prefWidth="750.0" style="-fx-background-color: white;" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
