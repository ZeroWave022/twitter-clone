{
  "java.configuration.updateBuildConfiguration": "automatic",
  "[java]": {
    "editor.tabSize": 2,
  },
  "[xml]": {
    "editor.formatOnSave": false
  },
  "java.test.config": [
    {
      "name": "coreTesting",
      "vmArgs": []
    },
    {
      "name": "twitter-clone testing",
      "vmArgs": [
        "--add-opens",
        "twitter.ui/ui=ALL-UNNAMED",
        "--add-exports",
        "javafx.graphics/com.sun.javafx.application=ALL-UNNAMED",
        "--add-opens",
        "javafx.graphics/com.sun.javafx.application=ALL-UNNAMED"
      ]
    }
  ],
  "java.test.defaultConfig": "twitter-clone testing",
  "java.compile.nullAnalysis.mode": "automatic",
  "java.debug.settings.onBuildFailureProceed": true,
  "java.format.settings.url": ".vscode/java-formatter.xml",
  "java.format.settings.profile": "JavaConventions",
  "java.checkstyle.configuration": "twitter-clone/config/checkstyle/google_checks.xml",
  "java.checkstyle.version": "11.0.1"
}
